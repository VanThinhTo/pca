# PCA and clustering

```{r fig.width=7, fig.height=4.5}
# Calculate size PCA; Origin is supplementary.
pca2 <- PCA(five_input[c("Num_Atoms", "Rg", "Origin")],
            scale.unit = TRUE, quali.sup = 3, graph = FALSE)
# pca2 <- PCA(five_input,
#             scale.unit = TRUE, quali.sup = 6, graph = FALSE)
colors_ward <- c("red", "blue", "green", "orange")
colors_origin <- c(PROT = "#2166AC", RNA = "#B2182B")
pc <- pca2$ind$coord[, 1:2]

# Leave space on the right for the legends.
old_par <- par(mar = c(5, 4, 4, 7))
plot(pc, type = "n", xlab = "PC1", ylab = "PC2",
     main = "Ward clusters on PCA")

# Shade the region enclosing each cluster.
for (g in 1:4) {
  group <- pc[cut_ward == g, ]
  polygon(group[chull(group), ],
          col = adjustcolor(colors_ward[g], alpha.f = 0.2),
          border = colors_ward[g])
}

# Color the points by Origin and place both legends outside the plot.
points(pc, col = colors_origin[as.character(five_input$Origin)], pch = 19)
legend("topright", inset = c(-0.2, 0), xpd = TRUE,
       legend = c("Protein", "RNA"), col = colors_origin,
       pch = 19, title = "Origin", bty = "n")
legend("bottomright", inset = c(-0.2, 0), xpd = TRUE,
       legend = 1:4, fill = adjustcolor(colors_ward, alpha.f = 0.2),
       border = colors_ward, title = "Cluster", bty = "n")
par(old_par)
```

