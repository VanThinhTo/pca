# Session 2 — Hierarchical clustering and linkage

## Dendrogram for three ratios

```{r without scale}
#build the data
X3wo <- shape_input[shape_names]
#calculate the distance
distx3wo <- dist(X3wo) #weighted Euclidean
#build the dendrogram
avg_tree <- hclust(distx3wo, method = "ward.D2")

#Find the best cluster by NbClust
library(NbClust)
Nb_res <-  NbClust(X3wo, method="ward.D2")
cut_avg <- cutree(avg_tree, k=3)

plot(avg_tree, hang=-1, label=FALSE)
rect.hclust(avg_tree, k=3)

sil_res <- silhouette(x=cut_avg, dist = distx3wo)
plot(sil_res, col = c("red", "blue","green"), border = NA) #, "green", "orange"
```

