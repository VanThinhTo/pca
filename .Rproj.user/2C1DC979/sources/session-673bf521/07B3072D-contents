dist_shape <- dist(x4)
dist_five <- dist(z4)

# Build both Ward partitions and check the repeated one is unchanged.
tree_shape <- hclust(dist_shape, method = "ward.D2")
tree_five <- hclust(dist_five, method = "ward.D2")
